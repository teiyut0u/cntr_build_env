# syntax=docker/dockerfile:1
#
# Template for a QEMU build environment.
# Render it with build_image.sh, which substitutes:
#
#   __UBUNTU_RELEASE__  base image tag, e.g. latest, noble, 24.04
#
# The QEMU source is NOT downloaded here; it is bind-mounted at /build/qemu.

FROM ubuntu:__UBUNTU_RELEASE__

LABEL org.opencontainers.image.title="qemu-builder" \
      org.opencontainers.image.description="QEMU build environment on Ubuntu __UBUNTU_RELEASE__"

# Fail fast in RUN steps that chain commands with ';'.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Enable deb-src entries: `apt build-dep` needs them.
# Then, isntall QEMU's own Build-Depends (gcc, meson, ninja-build, glib, pixman, ...).
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -ri 's/^Types: deb([[:space:]]*)$/Types: deb deb-src\1/' \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
        sed -ri 's/^#[[:space:]]*deb-src/deb-src/' /etc/apt/sources.list; \
    fi; \
    deb_src_found=0; \
    if grep -qs 'deb-src' /etc/apt/sources.list.d/ubuntu.sources; then \
        deb_src_found=1; \
    fi; \
    if [ -f /etc/apt/sources.list ] && grep -qs '^deb-src' /etc/apt/sources.list; then \
        deb_src_found=1; \
    fi; \
    if [ "$deb_src_found" -eq 0 ]; then \
        echo 'error: could not enable deb-src entries' >&2; \
        exit 1; \
    fi; \
    apt-get update; \
    apt-get build-dep -y qemu; \
    rm -rf /var/lib/apt/lists/*

# The build logic lives in its own script and is baked into the image, so the
# host side only has to pass mounts/args.  It can also be run by hand:
#   docker run --rm -v <src>:/build/qemu \
#       -e HOST_UID=$(id -u) -e HOST_GID=$(id -g) qemu_builder:latest \
#       qemu-build.sh -j <jobs> -- <configure args>
COPY build_in_container.sh /usr/local/bin/qemu-build.sh

# /build/qemu is the mounted source tree, /build/qemu/build the default build
# directory (see qemu-build.sh --help).  The script chowns the mounted tree and
# the build directory to HOST_UID:HOST_GID and re-executes itself with setpriv,
# so the build does not leave root-owned files on the host.  /build is
# world-writable so that also works when the build runs without root.
RUN set -eux; \
    chmod 0755 /usr/local/bin/qemu-build.sh; \
    command -v setpriv; \
    mkdir -p /build; \
    chmod 1777 /build

WORKDIR /build

CMD ["bash"]
